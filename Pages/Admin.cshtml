@page
@{ Layout = null; }
<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mystery Boxes – Admin</title><link rel="stylesheet" href="/css/site.css"></head>
<body><main class="admin"><h1>Mystery Boxes – panel administratora</h1>
<section class="panel"><h2>Połączenie Twitch</h2><p id="twitchStatus">Sprawdzanie...</p><a class="button" href="/twitch/connect">Połącz konto Twitch</a><button onclick="disconnectTwitch()">Rozłącz</button><p class="hint">Wymagane scope: user:read:chat oraz user:write:chat. Ustaw Client ID, Client Secret i Redirect URI w appsettings.json.</p></section>
<section class="panel"><h2>Wygląd widżetu</h2><label>Tytuł <input id="titleInput" value="MYSTERY BOXES"></label><div class="colors"><label>Tło <input id="bg" type="color" value="#071a13"></label><label>Pola <input id="box" type="color" value="#164632"></label><label>Akcent <input id="accent" type="color" value="#54ffae"></label><label>Kolumny <select id="columns"><option>4</option><option>5</option><option selected>6</option><option>7</option><option>8</option></select></label></div><button onclick="saveSettings()">Zapisz wygląd</button>
<label>SubLuck – mnożnik zgłoszenia subskrybenta <input id="subLuck" type="number" min="1" max="100" value="1"></label>
<p class="hint">1 = standardowa szansa, 2 = dwa losy, 3 = trzy losy itd. Osoby bez suba zawsze mają mnożnik 1.</p>
<button onclick="saveSubLuck()">Zapisz SubLuck</button>
<div class="overlay-link-box"><strong>Widżet OBS</strong><p class="hint">Ten adres dodaj w OBS jako źródło „Przeglądarka”. Możesz też otworzyć podgląd w nowej karcie.</p><div class="overlay-link-row"><input id="overlayUrl" readonly aria-label="Link do overlay OBS"><button onclick="copyOverlayUrl()">Kopiuj link</button><button class="secondary" onclick="openOverlay()">Otwórz overlay ↗</button></div></div></section>
<section class="panel"><h2>Animacja i dźwięk nagrody</h2>
<p class="hint">Po wybraniu paczki widżet pokaże animację otwierania i prezentacji nagrody. Dźwięk będzie odtwarzany w źródle przeglądarki OBS.</p>
<label>Własny dźwięk (MP3, WAV lub OGG, maks. 10 MB)<input id="soundFile" type="file" accept="audio/mpeg,audio/wav,audio/ogg,.mp3,.wav,.ogg"></label>
<div class="actions"><button onclick="uploadAnimationSound()">Wgraj i zapisz dźwięk</button><button class="secondary" onclick="resetAnimationSound()">Przywróć domyślny dźwięk</button><button class="secondary" onclick="previewAnimationSound()">Odsłuchaj</button></div>
<p id="soundStatus" class="hint">Aktualny dźwięk: domyślny</p><audio id="soundPreview" controls style="width:100%;max-width:420px"></audio></section>
<section class="panel"><h2>Sterowanie losowaniem</h2><div class="actions"><button onclick="action('start')">Otwórz zapisy</button><button onclick="action('close')">Zakończ zapisy</button><button onclick="action('draw')">Losuj zwycięzcę</button><button class="secondary" onclick="action('cancel-round')">Anuluj rundę</button></div><p id="result"></p><div id="roundState"></div></section>
<section class="panel"><h2>24 nagrody</h2><p class="hint">Wszystkie paczki na start mają grafikę prezentu. Możesz zmienić nazwę i wgrać własny obraz.</p><div id="prizes" class="prize-editor"></div><button onclick="action('shuffle')">Przetasuj nagrody</button><button class="secondary" onclick="action('new-event')">Nowe wydarzenie – zakryj i przetasuj później</button></section>
<section class="panel"><h2>Historia rund</h2><div id="history"></div></section></main><script src="/js/admin.js"></script></body></html>
