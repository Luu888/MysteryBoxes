@page "/Overlay"
@{ Layout = null; }
<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Mystery Boxes</title>
    <link rel="stylesheet" href="/css/overlay.css">
</head>
<body>
<main id="stage" class="stage">
    <div class="stage-bg"></div>

    <section id="boxesLeft" class="boxes left"></section>
    <section id="boxesRight" class="boxes right"></section>

    <header class="title"><h1 id="title">MYSTERY BOXES</h1></header>
    <div class="camera"><span>KAMERA OBS<small>720 × 405 • X 600, Y 170</small></span></div>
    <section id="sponsors" class="sponsors" hidden>
        <h2>SPONSORZY</h2>
        <div id="sponsorLogos" class="sponsor-logos"></div>
        <p id="sponsorText"></p>
    </section>

    <div id="reveal" class="reveal" aria-hidden="true">
        <div class="reveal-backdrop"></div>
        <div class="reveal-card">
            <div class="reveal-kicker">MYSTERY BOXES</div>
            <div class="reveal-chest">🎁</div>
            <div class="reveal-flash"></div>
            <h2 id="revealName">NAGRODA!</h2>
            <img id="revealImage" src="/images/gift.svg" alt="">
            <p id="revealNumber"></p>
        </div>
    </div>
    <audio id="revealSound" preload="auto"></audio>
</main>
<script src="/js/overlay.js"></script>
</body>
</html>
